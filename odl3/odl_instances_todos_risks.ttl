#############################################################
# 风险实例
#############################################################

### 大数据左移相关风险
ex:Risk_BDPDeadlock rdf:type odl:Risk ;
  rdfs:label "BDP凌晨底层死锁问题" ;
  odl:riskDescription "BDP凌晨问题已定位，是底层死锁问题，需寻找风险较小的改动方案解决" ;
  odl:riskLevel "高" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "可能导致批量运行不稳定，需要谨慎处理以免影响关键批量运行" ;
  odl:affectsCost false ;
  odl:mitigationMeasure "正在寻找风险较小的改动方案解决底层死锁问题" ;
  odl:riskSource ex:Theme_BigDataLeftShift .

ex:Risk_DataSyncProblem rdf:type odl:Risk ;
  rdfs:label "生产-准生产导数通道问题" ;
  odl:riskDescription "灾备与生产同步问题：目前只有CNC存在此问题，其余部分可接受短期同步在线" ;
  odl:riskLevel "中" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "等5月人力释放后启动" ;
  odl:affectsCost true ;
  odl:costImpact "需额外资源支持数据导数功能开发" ;
  odl:mitigationMeasure "后续可通过提单方式处理CNC的同步问题，功能上线后再梳理" ;
  odl:riskSource ex:Theme_BigDataLeftShift .

ex:Risk_PublishProcessMissing rdf:type odl:Risk ;
  rdfs:label "发文流程问题：漏了向各部门接口人征求意见的环节" ;
  odl:riskDescription "批量等级规范发文申请漏了向各部门接口人征求意见的环节，可能影响发文质量和接受度" ;
  odl:riskLevel "低" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "需重新按流程发送邮件，争取本周完成" ;
  odl:affectsCost false ;
  odl:mitigationMeasure "需重新按流程发送邮件，参考发文流程指引和邮件模板，与嘉伟沟通" ;
  odl:riskSource ex:Theme_BigDataLeftShift .

ex:Risk_DataQualityIssue rdf:type odl:Risk ;
  rdfs:label "各部门存量和3月份数据存在质量问题" ;
  odl:riskDescription "启通和财富的打标数据存在问题，需手动修正；基科存量数据通过问题单卡点" ;
  odl:riskLevel "中" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "会影响数据导入和初始化进度" ;
  odl:affectsCost false ;
  odl:mitigationMeasure "由相关人员完成数据填充和修改；拉群跟进TCS环境打标数据不够的问题" ;
  odl:riskSource ex:Theme_BigDataLeftShift .

### AI应用可运维性相关风险
ex:Risk_AIMonitoringFalsePositives rdf:type odl:Risk ;
  rdfs:label "AI监控误报偏多" ;
  odl:riskDescription "目前AI监控误高偏多，后续将继续验证有效性" ;
  odl:riskLevel "中" ;
  odl:riskStatus "持续监控" ;
  odl:affectsSchedule false ;
  odl:affectsCost false ;
  odl:mitigationMeasure "继续验证AI监控的有效性，优化监控算法" ;
  odl:riskSouce ex:Theme_AIApplication .

ex:Risk_AIApplicationAccessDelay rdf:type odl:Risk ;
  rdfs:label "系统接入问题导致接入率未达预期" ;
  odl:riskDescription "部分系统如财富在测试环境试点，生产未应用JSDK；贷款系统和5年试点系统未在清单内；存款系统缺TOKEN字段，接入率未达预期" ;
  odl:riskLevel "中" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "可能影响按月推进计划" ;
  odl:affectCost false ;
  odl:mitigationMeasure "新增数据录入CNP修复中，截止到12月；与存款生产接口权限开通后开始上报" ;
  odl:riskSource ex:Theme_AIApplication .

### 批量监控相关风险
ex:Risk_MonitoringAlgorithmLimit rdf:type odl:Risk ;
  rdfs:label "监控算法对月趋势性数据不支持" ;
  odl:riskDescription "监控算法对月趋势性数据不支持，该问题源于运营例会" ;
  odl:riskLevel "低" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule false ;
  odl:affectsCost false ;
  odl:mitigationMeasure "需回到运营例会讨论如何跟踪和衡量该工作的效果，找到问题源头并汇报进展" ;
  odl:riskSource ex:Theme_BatchMonitoring .

ex:Risk_CNCGrayScaleDelay rdf:type odl:Risk ;
  rdfs:label "CNC灰度指标检测需求导致批量监控延迟" ;
  odl:riskDescription "因插了CNC的灰度指标检测需求，批量数据量监控可能延迟两周" ;
  odl:riskLevel "低" ;
  odl:riskStatus "处理中" ;
  odl:affectsSchedule true ;
  odl:scheduleImpact "争取4月内完成，可能因灰度指标检测需求延迟两周" ;
  odl:affectsCost false ;
  odl:mitigationMeasure "争取4月内完成批量监控和告警优化" ;
  odl:riskSource ex:Theme_BatchMonitoring .

