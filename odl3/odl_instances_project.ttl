@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix odl: <http://webank.com/odl/ontology#> .
@prefix ex: <http://webank.com/odl/instance#> .

#############################################################
# 项目实例
#############################################################

ex:ODL_Project rdf:type odl:Project ;
  rdfs:label "ODL项目" ;
  rdfs:comment "运维开发生命周期管理项目" ;
  odl:description "ODL是运维开发生命周期管理(Operations Development Lifecycle)的简称。它是一种管理方法，目的是将可运维性要求左移，在需求阶段就融入运维相关要求，并通过规范、工具等方式确保这些要求在开发过程中得到贯彻。ODL用于行内所有业务系统的研发过程，涉及包括CNC在内的多个开发部门。" ;
  odl:startTime "2025-05-01T00:00:00"^^xsd:dateTime ;
  odl:status "进行中" ;
  odl:priority "重要" .

