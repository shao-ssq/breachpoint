#############################################################
# 人员实例
#############################################################

# 决策层
ex:Person_JiangMin rdf:type odl:Person ;
  rdfs:label "江旻" ;
  odl:nameCn "江旻" ;
  odl:nameEn "minjiang" ;
  odl:role "项目领导" ;
  odl:responsibility "作为TIG条线副总裁，是ODL项目的总负责人。主要在每个月例会上，了解进度、风险。并提出新的想法或者要求。" ;
  odl:belongsToDepartment ex:Department_TIG ;
  odl:responsibleFor ex:ODL_Project .

ex:Person_XuGaoQian rdf:type odl:Person ;
  rdfs:label "徐高骞" ;
  odl:nameCn "徐高骞" ;
  odl:nameEn "anallanxu" ;
  odl:role "项目管理" ;
  odl:responsibility "是CNC的副总经理，分管系统运营。被江旻指派为ODL的次级负责人。主要组织周例会，跟进进度。并在每个月向江旻汇报。" ;
  odl:belongsToDepartment ex:Department_CNC ;
  odl:reportsTo ex:Person_JiangMin ;
  odl:responsibleFor ex:ODL_Project .

# 主题负责人和核心人员
ex:Person_HeLiu rdf:type odl:Person ;
  rdfs:label "何流" ;
  odl:nameCn "何流" ;
  odl:nameEn "tigerhe" ;
  odl:role "主持人" ;
  odl:responsibility "是CNC运营科室的员工，徐高骞是其领导。主要职责是ODL的任务管理、收集，和会议的组织、材料的准备等工作。负责异常报错定位专题的推进工作。" ;
  odl:belongsToDepartment ex:Department_CNC ;
  odl:reportsTo ex:Person_XuGaoQian ;
  odl:responsibleFor ex:Theme_ExceptionLocation ;
  odl:responsibleFor ex:ODL_Project .

ex:Person_HuangQiaoLong rdf:type odl:Person ;
  rdfs:label "黄俏龙" ;
  odl:nameCn "黄俏龙" ;
  odl:nameEn "huangqiaolong" ;
  odl:role "专题负责人" ;
  odl:responsibility "负责监管规则一致性agent专题，包括异常规则快模式运营、规则部署推广、协同各科技部门推广等工作。" ;
  odl:belongsToDepartment ex:Department_CNC ;
  odl:responsibleFor ex:Theme_RuleConsistency .

