  odl:nameEn "zhujiawei" ;
  odl:role "专题负责人" ;
  odl:responsibility "负责大数据领域可运维性左移专题，包括批量应用等级划分、规范发文、各部门任务打标与队列调整等。已于2026年3月交接给玉如。" ;
  odl:belongsToDepartment ex:Department_JiKe ;
  odl:responsibility "批量应用等级划分与规范发文、各部门任务打标与队列调整" .

