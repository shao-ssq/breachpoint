@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix odl: <http://webank.com/odl/ontology#> .
@prefix ex: <http://webank.com/odl/instance#> .

<http://webank.com/odl/ontology> rdf:type owl:Ontology ;
  rdfs:label "ODL项目本体" ;
  rdfs:comment "运维开发生命周期管理(ODL)项目的本体定义，用于构建项目知识图谱" ;
  owl:versionInfo "1.0" .

#############################################################
# 类定义 (Classes)
#############################################################

odl:Project rdf:type owl:Class ;
  rdfs:label "项目" ;
  rdfs:comment "ODL管理的项目实体" .

odl:Theme rdf:type owl:Class ;
  rdfs:label "主题任务" ;
  rdfs:comment "ODL项目的主题任务，包括运维效能、数据治理、AI赋能、基础设施等" .

odl:Task rdf:type owl:Class ;
  rdfs:label "任务" ;
  rdfs:comment "具体的任务项" .

odl:Meeting rdf:type owl:Class ;
  rdfs:label "会议" ;
  rdfs:comment "ODL相关的会议记录" .

odl:Person rdf:type owl:Class ;
  rdfs:label "人员" ;
  rdfs:comment "参与ODL项目的人员" .

odl:Department rdf:type owl:Class ;
  rdfs:label "部门" ;
  rdfs:comment "参与ODL项目的部门" .

odl:TodoItem rdf:type owl:Class ;
  rdfs:label "待办事项" ;
  rdfs:comment "会议或项目中产生的待办事项" .

odl:Risk rdf:type owl:Class ;
  rdfs:label "风险" ;
  rdfs:comment "项目或任务相关的风险" .

odl:Document rdf:type owl:Class ;
  rdfs:label "文档" ;
  rdfs:comment "项目相关的文档材料" .

odl:System rdf:type owl:Class ;
  rdfs:label "系统" ;
  rdfs:comment "ODL相关的IT系统" .

odl:Tool rdf:type owl:Class ;
  rdfs:label "工具" ;
  rdfs:comment "ODL使用的工具组件" .

odl:Milestone rdf:type owl:Class ;
  rdfs:label "里程碑" ;
  rdfs:comment "关键的时间节点或里程碑" .

odl:Indicator rdf:type owl:Class ;
  rdfs:label "指标" ;
  rdfs:comment "用于衡量项目进展的指标" .

odl:Tag rdf:type owl:Class ;
  rdfs:label "标签" ;
  rdfs:comment "用于分类和标记的标签" .

#############################################################
# 数据属性 (Data Properties)
#############################################################

# 时间属性
odl:startTime rdf:type owl:DatatypeProperty ;
  rdfs:label "开始时间" ;
  rdfs:range xsd:dateTime .

odl:endTime rdf:type owl:DatatypeProperty ;
  rdfs:label "结束时间" ;
  rdfs:range xsd:dateTime .

odl:deadlineTime rdf:type owl:DatatypeProperty ;
  rdfs:label "截止时间" ;
  rdfs:range xsd:dateTime .

odl:updateTime rdf:type owl:DatatypeProperty ;
  rdfs:label "更新时间" ;
  rdfs:range xsd:dateTime .

odl:plannedCompletionTime rdf:type owl:DatatypeProperty ;
  rdfs:label "预计完成时间" ;
  rdfs:range xsd:dateTime .

odl:actualCompletionTime rdf:type owl:DatatypeProperty ;
  rdfs:label "实际完成时间" ;
  rdfs:range xsd:dateTime .

# 状态属性
odl:status rdf:type owl:DatatypeProperty ;
  rdfs:label "状态" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf (
      "待启动"
      "进行中"
      "暂停"
      "延期"
      "完成"
      "关闭"
      "运营中"
      "推广中"
      "实施中"
      "启动中"
      "推进中"
      "常态化"
      "待处理"
      "处理中"
      "已处理"
      "待审核"
      "审核中"
      "已审核"
    )
  ] .

# 等级属性
odl:priority rdf:type owl:DatatypeProperty ;
  rdfs:label "优先级" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("紧急" "普通" "高" "中" "低" "P0" "P1" "P2" "P3")
  ] .

odl:importanceLevel rdf:type owl:DatatypeProperty ;
  rdfs:label "重要程度" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("重要" "一般")
  ] .

odl:riskLevel rdf:type owl:DatatypeProperty ;
  rdfs:label "风险等级" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("高" "中" "低")
  ] .

odl:batchLevel rdf:type owl:DatatypeProperty ;
  rdfs:label "批量等级" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("一级" "二级" "三级" "A类" "B类" "C类" "D类")
  ] .

# 描述属性
odl:contentDescription rdf:type owl:DatatypeProperty ;
  rdfs:label "内容说明" ;
  rdfs:range xsd:string .

odl:remark rdf:type owl:DatatypeProperty ;
  rdfs:label "备注" ;
  rdfs:range xsd:string .

odl:basis rdf:type owl:DatatypeProperty ;
  rdfs:label "依据" ;
  rdfs:range xsd:string .

odl:requirement rdf:type owl:DatatypeProperty ;
  rdfs:label "要求" ;
  rdfs:range xsd:string .

odl:description rdf:type owl:DatatypeProperty ;
  rdfs:label "描述" ;
  rdfs:range xsd:string .

odl:delayReason rdf:type owl:DatatypeProperty ;
  rdfs:label "延迟理由" ;
  rdfs:range xsd:string .

odl:solution rdf:type owl:DatatypeProperty ;
  rdfs:label "解决方案" ;
  rdfs:range xsd:string .

odl:blockingIssue rdf:type owl:DatatypeProperty ;
  rdfs:label "阻碍问题" ;
  rdfs:range xsd:string .

odl:progress rdf:type owl:DatatypeProperty ;
  rdfs:label "进度" ;
  rdfs:range xsd:string .

odl:progressPercentage rdf:type owl:DatatypeProperty ;
  rdfs:label "进度百分比" ;
  rdfs:range xsd:decimal .

# 关联属性
odl:relatedProject rdf:type owl:DatatypeProperty ;
  rdfs:label "关联项目" ;
  rdfs:range xsd:string .

odl:relatedTask rdf:type owl:DatatypeProperty ;
  rdfs:label "关联任务" ;
  rdfs:range xsd:string .

odl:relatedMeeting rdf:type owl:DatatypeProperty ;
  rdfs:label "关联会议" ;
  rdfs:range xsd:string .

odl:relatedDocument rdf:type owl:DatatypeProperty ;
  rdfs:label "关联文档" ;
  rdfs:range xsd:string .

# 风险影响属性
odl:affectsSchedule rdf:type owl:DatatypeProperty ;
  rdfs:label "影响工期" ;
  rdfs:range xsd:boolean .

odl:affectsCost rdf:type owl:DatatypeProperty ;
  rdfs:label "影响成本" ;
  rdfs:range xsd:boolean .

odl:scheduleImpact rdf:type owl:DatatypeProperty ;
  rdfs:label "工期影响详情" ;
  rdfs:range xsd:string .

odl:costImpact rdf:type owl:DatatypeProperty ;
  rdfs:label "成本影响详情" ;
  rdfs:range xsd:string .

# 人员属性
odl:name rdf:type owl:DatatypeProperty ;
  rdfs:label "姓名" ;
  rdfs:range xsd:string .

odl:nameCn rdf:type owl:DatatypeProperty ;
  rdfs:label "中文名称" ;
  rdfs:range xsd:string .

odl:nameEn rdf:type owl:DatatypeProperty ;
  rdfs:label "英文名称" ;
  rdfs:range xsd:string .

odl:nameShort rdf:type owl:DatatypeProperty ;
  rdfs:label "简称" ;
  rdfs:range xsd:string .

odl:email rdf:type owl:DatatypeProperty ;
  rdfs:label "邮箱" ;
  rdfs:range xsd:string .

odl:role rdf:type owl:DatatypeProperty ;
  rdfs:label "角色" ;
  rdfs:range xsd:string .

odl:responsibility rdf:type owl:DatatypeProperty ;
  rdfs:label "职责" ;
  rdfs:range xsd:string .

# 部门属性
odl:departmentName rdf:type owl:DatatypeProperty ;
  rdfs:label "部门名称" ;
  rdfs:range xsd:string .

odl:departmentCn rdf:type owl:DatatypeProperty ;
  rdfs:label "部门中文名称" ;
  rdfs:range xsd:string .

odl:departmentEn rdf:type owl:DatatypeProperty ;
  rdfs:label "部门英文名称" ;
  rdfs:range xsd:string .

odl:departmentShort rdf:type owl:DatatypeProperty ;
  rdfs:label "部门简称" ;
  rdfs:range xsd:string .

# 会议属性
odl:meetingTitle rdf:type owl:DatatypeProperty ;
  rdfs:label "会议标题" ;
  rdfs:range xsd:string .

odl:meetingType rdf:type owl:DatatypeProperty ;
  rdfs:label "会议类型" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("周例会" "月度例会" "专题会" "讨论会")
  ] .

odl:location rdf:type owl:DatatypeProperty ;
  rdfs:label "地点" ;
  rdfs:range xsd:string .

odl:host rdf:type owl:DatatypeProperty ;
  rdfs:label "主持人" ;
  rdfs:range xsd:string .

odl:recorder rdf:type owl:DatatypeProperty ;
  rdfs:label "记录人" ;
  rdfs:range xsd:string .

odl:attendees rdf:type owl:DatatypeProperty ;
  rdfs:label "参会人员" ;
  rdfs:range xsd:string .

odl:meetingContent rdf:type owl:DatatypeProperty ;
  rdfs:label "会议内容" ;
  rdfs:range xsd:string .

odl:meetingConclusion rdf:type owl:DatatypeProperty ;
  rdfs:label "会议结论" ;
  rdfs:range xsd:string .

odl:decisionRecorded rdf:type owl:DatatypeProperty ;
  rdfs:label "决策记录" ;
  rdfs:range xsd:string .

odl:keyQuotes rdf:type owl:DatatypeProperty ;
  rdfs:label "关键观点" ;
  rdfs:range xsd:string .

# 主题分类属性
odl:themeCategory rdf:type owl:DatatypeProperty ;
  rdfs:label "主题分类" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("运维效能类" "数据治理类" "AI赋能类" "基础设施类")
  ] .

odl:themeFocus rdf:type owl:DatatypeProperty ;
  rdfs:label "核心关注点" ;
  rdfs:range xsd:string .

# 指标属性
odl:indicatorName rdf:type owl:DatatypeProperty ;
  rdfs:label "指标名称" ;
  rdfs:range xsd:string .

odl:indicatorValue rdf:type owl:DatatypeProperty ;
  rdfs:label "指标值" ;
  rdfs:range xsd:string .

odl:targetValue rdf:type owl:DatatypeProperty ;
  rdfs:label "目标值" ;
  rdfs:range xsd:string .

odl:baselineValue rdf:type owl:DatatypeProperty ;
  rdfs:label "基准值" ;
  rdfs:range xsd:string .

odl:unit rdf:type owl:DatatypeProperty ;
  rdfs:label "单位" ;
  rdfs:range xsd:string .

odl:measurementDate rdf:type owl:DatatypeProperty ;
  rdfs:label "测量日期" ;
  rdfs:range xsd:date .

# 系统属性
odl:systemName rdf:type owl:DatatypeProperty ;
  rdfs:label "系统名称" ;
  rdfs:range xsd:string .

odl:systemType rdf:type owl:DatatypeProperty ;
  rdfs:label "系统类型" ;
  rdfs:range xsd:string .

odl:systemLevel rdf:type owl:DatatypeProperty ;
  rdfs:label "系统级别" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("A类" "B类" "C类")
  ] .

# 工具属性
odl:toolName rdf:type owl:DatatypeProperty ;
  rdfs:label "工具名称" ;
  rdfs:range xsd:string .

odl:toolFunction rdf:type owl:DatatypeProperty ;
  rdfs:label "工具功能" ;
  rdfs:range xsd:string .

odl:toolStatus rdf:type owl:DatatypeProperty ;
  rdfs:label "工具状态" ;
  rdfs:range xsd:string .

# 文档属性
odl:documentTitle rdf:type owl:DatatypeProperty ;
  rdfs:label "文档标题" ;
  rdfs:range xsd:string .

odl:documentType rdf:type owl:DatatypeProperty ;
  rdfs:label "文档类型" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("会议纪要" "月报" "周报" "方案文档" "规范文档")
  ] .

odl:documentPath rdf:type owl:DatatypeProperty ;
  rdfs:label "文档路径" ;
  rdfs:range xsd:string .

odl:documentDate rdf:type owl:DatatypeProperty ;
  rdfs:label "文档日期" ;
  rdfs:range xsd:date .

# 待办属性
odl:todoDescription rdf:type owl:DatatypeProperty ;
  rdfs:label "待办描述" ;
  rdfs:range xsd:string .

odl:isCompleted rdf:type owl:DatatypeProperty ;
  rdfs:label "是否完成" ;
  rdfs:range xsd:boolean .

odl:completionDate rdf:type owl:DatatypeProperty ;
  rdfs:label "完成日期" ;
  rdfs:range xsd:date .

odl:overdue rdf:type owl:DatatypeProperty ;
  rdfs:label "是否超时" ;
  rdfs:range xsd:boolean .

# 风险属性
odl:riskDescription rdf:type owl:DatatypeProperty ;
  rdfs:label "风险描述" ;
  rdfs:range xsd:string .

odl:mitigationMeasure rdf:type owl:DatatypeProperty ;
  rdfs:label "缓解措施" ;
  rdfs:range xsd:string .

odl:riskStatus rdf:type owl:DatatypeProperty ;
  rdfs:label "风险状态" ;
  rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:oneOf ("发现" "分析中" "处理中" "已闭环" "持续监控")
  ] .

odl:riskSource rdf:type owl:DatatypeProperty ;
  rdfs:label "风险来源" ;
  rdfs:range xsd:string .

# 效果属性
odl:effectiveness rdf:type owl:DatatypeProperty ;
  rdfs:label "成效" ;
  rdfs:range xsd:string .

odl:savedManMonths rdf:type owl:DatatypeProperty ;
  rdfs:label "节省人月数" ;
  rdfs:range xsd:decimal .

odl:efficiencyGain rdf:type owl:DatatypeProperty ;
  rdfs:label "效率提升" ;
  rdfs:range xsd:string .

#############################################################
# 对象属性 (Object Properties) - 归属关系
#############################################################

odl:belongsTo rdf:type owl:ObjectProperty ;
  rdfs:label "属于" ;
  rdfs:comment "实体属于另一个实体" ;
  rdfs:domain odl:Task ;
  rdfs:range [
    odl:Theme
    odl:Project
  ] .

odl:contains rdf:type owl:ObjectProperty ;
  rdfs:label "包含" ;
  rdfs:comment "实体包含另一个实体" ;
  rdfs:domain [
    odl:Project
    odl:Theme
  ] ;
  rdfs:range [
    odl:Theme
    odl:Task
  ] .

odl:subordinateTo rdf:type owl:ObjectProperty ;
  rdfs:label "隶属于" ;
  rdfs:comment "实体隶属于另一个实体" ;
  rdfs:domain [
    odl:Person
    odl:Department
  ] ;
  rdfs:range odl:Department .

odl:partOf rdf:type owl:ObjectProperty ;
  rdfs:label "是...的一部分" ;
  rdfs:domain odl:Task ;
  rdfs:range odl:Theme .

#############################################################
# 对象属性 (Object Properties) - 负责关系
#############################################################

odl:responsibleFor rdf:type owl:ObjectProperty ;
  rdfs:label "负责" ;
  rdfs:comment "人员对实体的负责关系" ;
  rdfs:domain odl:Person ;
  rdfs:range [
    odl:Theme
    odl:Task
    odl:Project
  ] .

odl:supervises rdf:type owl:ObjectProperty ;
  rdfs:label "分管" ;
  rdfs:comment "上级对下级的分管关系" ;
  rdfs:domain odl:Person ;
  rdfs:range odl:Theme .

odl:leads rdf:type owl:ObjectProperty ;
  rdfs:label "牵头" ;
  rdfs:comment "人员牵头某项工作" ;
  rdfs:domain odl:Person ;
  rdfs:range [
    odl:Theme
    odl:Task
  ] .

odl:collaboratesWith rdf:type owl:ObjectProperty ;
  rdfs:label "配合" ;
  rdfs:comment "配合某项工作" ;
  rdfs:domain odl:Person ;
  rdfs:range [
    odl:Theme
    odl:Task
  ] .

odl:supports rdf:type owl:ObjectProperty ;
  rdfs:label "支持" ;
  rdfs:comment "支持某项工作" ;
  rdfs:domain odl:Person ;
  rdfs:range [
    odl:Theme
    odl:Task
    odl:Person
  ] .

odl:hostedBy rdf:type owl:ObjectProperty ;
  rdfs:label "由...主持" ;
  rdfs:domain odl:Meeting ;
  rdfs:range odl:Person .

odl:recordedBy rdf:type owl:ObjectProperty ;
  rdfs:label "由...记录" ;
  rdfs:domain odl:Meeting ;
  rdfs:range odl:Person .

odl:assignedTo rdf:type owl:ObjectProperty ;
  rdfs:label "指派给" ;
  rdfs:domain [
    odl:Task
    odl:TodoItem
  ] ;
  rdfs:range odl:Person .

#############################################################
# 对象属性 (Object Properties) - 时序关系
#############################################################

odl:precedes rdf:type owl:ObjectProperty ;
  rdfs:label "前置" ;
  rdfs:comment "任务的前后顺序关系，A前置B表示B依赖A的完成" ;
  rdfs:domain odl:Task ;
  rdfs:range odl:Task .

odl:succeeds rdf:type owl:ObjectProperty ;
  rdfs:label "后续" ;
  rdfs:comment "任务的后续关系，A是B的后续" ;
  rdfs:domain odl:Task ;
  rdfs:range odl:Task .

odl:parallelWith rdf:type owl:ObjectProperty ;
  rdfs:label "并行" ;
  rdfs:comment "任务并行执行" ;
  rdfs:domain odl:Task ;
  rdfs:range odl:Task .

odl:delayedUntil rdf:type owl:ObjectProperty ;
  rdfs:label "延期至" ;
  rdfs:comment "任务延期到某个时间点" ;
  rdfs:domain odl:Task ;
  rdfs:range xsd:dateTime .

odl:hasMilestone rdf:type owl:ObjectProperty ;
  rdfs:label "有里程碑" ;
  rdfs:domain odl:Theme ;
  rdfs:range odl:Milestone .

odl:achievedMilestone rdf:type owl:ObjectProperty ;
  rdfs:label "达成里程碑" ;
  rdfs:subPropertyOf odl:hasMilestone ;
  rdfs:domain odl:Theme ;
  rdfs:range odl:Milestone .

#########################################################33
# 对象属性 (Object Properties) - 关联关系
#############################################################

odl:relatedTo rdf:type owl:ObjectProperty ;
  rdfs:label "关联" ;
  rdfs:comment "实体之间的关联关系" ;
  rdfs:range owl:Thing .

odl:reliesOn rdf:type owl:ObjectProperty ;
  rdfs:label "依赖" ;
  rdfs:comment "依赖其他实体" ;
  rdfs:domain [
    odl:Task
    odl:Theme
  ] ;
  rdfs:range [
    odl:Task
    odl:Theme
    odl:Tool
    odl:System
    odl:Document
  ] .

odl:references rdf:type owl:ObjectProperty ;
  rdfs:label "引用" ;
  rdfs:domain [
    odl:Meeting
    odl:Task
    odl:Document
  ] ;
  rdfs:range odl:Document .

odl:hasDocument rdf:type owl:ObjectProperty ;
  rdfs:label "有文档" ;
  rdfs:domain [
    odl:Theme
    odl:Task
    odl:Project
    odl:Meeting
  ] ;
  rdfs:range odl:Document .

odl:hasRisk rdf:type owl:ObjectProperty ;
  rdfs:label "有风险" ;
  rdfs:domain [
    odl:Theme
    odl:Task
  ] ;
  rdfs:range odl:Risk .

odl:hasTodo rdf:type owl:ObjectProperty ;
  rdfs:label "有待办" ;
  rdfs:domain [
    odl:Meeting
    odl:Theme
    odl:Project
  ] ;
  rdfs:range odl:TodoItem .

odl:discussedIn rdf:type owl:ObjectProperty ;
  rdfs:label "在...中讨论" ;
  rdfs:domain [
    odl:Theme
    odl:Task
    odl:Risk
  ] ;
  rdfs:range odl:Meeting .

odl:decisionMadeIn rdf:type owl:ObjectProperty ;
  rdfs:label "决策在...中作出" ;
  rdfs:domain [
    odl:Theme
    odl:Task
  ] ;
  rdfs:range odl:Meeting .

odl:hasIndicator rdf:type owl:ObjectProperty ;
  rdfs:label "有指标" ;
  rdfs:domain [
    odl:Theme
    odl:Task
    odl:Project
  ] ;
  rdfs:range odl:Indicator .

odl:usesTool rdf:type owl:ObjectProperty ;
  rdfs:label "使用工具" ;
  rdfs:domain [
    odl:Theme
    odl:Task
    odl:Person
  ] ;
  rdfs:range odl:Tool .

odl:involvesSystem rdf:type owl:ObjectProperty ;
  rdfs:label "涉及系统" ;
  rdfs:domain [
    odl:Theme
    odl:Task
  ] ;
  rdfs:range odl:System .

odl:belongsToDepartment rdf:type owl:ObjectProperty ;
  rdfs:label "所属部门" ;
  rdfs:domain odl:Person ;
  rdfs:range odl:Department .

odl:contactPerson rdf:type owl:ObjectProperty ;
  rdfs:label "接口人" ;
  rdfs:domain odl:Department ;
  rdfs:range odl:Person .

odl:departmentInterfacePerson rdf:type owl:ObjectProperty ;
  rdfs:label "部门接口人" ;
  rdfs:subPropertyOf odl:contactPerson .

odl:trackedIn rdf:type owl:ObjectProperty ;
  rdfs:label "跟踪于" ;
  rdfs:domain [
    odl:Theme
    odl:Task
    odl:Indicator
  ] ;
  rdfs:range odl:Document .

odl:reportedIn rdf:type owl:ObjectProperty ;
  rdfs:label "报告于" ;
  rdfs:subPropertyOf odl:trackedIn ;
  rdfs:domain odl:Indicator ;
  rdfs:range odl:Document .

odl:hasParticipant rdf:type owl:ObjectProperty ;
  rdfs:label "有参与者" ;
  rdfs:domain odl:Meeting ;
  rdfs:range odl:Person .

odl:hasConclusion rdf:type owl:ObjectProperty ;
  rdfs:label "有结论" ;
  rdfs:domain odl:Meeting ;
  rdfs:range xsd:string .

odl:hasDecision rdf:type owl:ObjectProperty ;
  rdfs:label "有决策" ;
  rdfs:domain odl:Meeting ;
  rdfs:range xsd:string .

odl:derivesFrom rdf:type owl:ObjectProperty ;
  rdfs:label "源于" ;
  rdfs:comment "知识或结论源于某会议或文档" ;
  rdfs:domain [
    odl:Task
    odl:Theme
    odl:Document
  ] ;
  rdfs:range [
    odl:Meeting
    odl:Document
  ] .