@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix odl: <http://webank.com/odl/ontology#> .
@prefix ex: <http://webank.com/odl/instance#> .

### 5. AI应用可运维性
ex:Theme_AIApplication rdf:type odl:Theme ;
  rdfs:label "AI应用可运维性" ;
  odl:description "完善AI应用监控，在AI应用运营管理规范中，需要开发遵循一定的日志规范进行日志打印和上报，其中ODL项目协助推动日志规范的落地。" ;
  odl:themeCategory "AI赋能类" ;
  odl:themeFocus "AI应用监控、日志规范、推广接入" ;
  odl:startTime "2025-11-01T00:00:00"^^xsd:dateTime ;
  odl:plannedCompletionTime "2026-06-30T23:59:59"^^xsd:dateTime ;
  odl:status "推广中" ;
  odl:priority "重要" ;
  odl:belongsTo ex:ODL_Project ;
  odl:responsibleFor ex:Person_XuShengAn ;
  odl:contentDescription "cnc监管报告agent基础监控功能测试验证，部门试点完成率提升至100%，所有部门完成试点，监控试点稽核已上线" ;
  odl:effectiveness "推广排期率提升至69%(51/74)，生产介入率数据统计为4%(3/74)。存量应用计划6月完成接入" ;
  odl:progress "监控试点稽核已上线，所有部门均完成试点，预计6月完成存量工作" ;
  odl:progressPercentage "7.5"^^xsd:decimal .

ex:Theme_AIApplication odl:hasTool ex:Tool_IMSSDK .
ex:Theme_AIApplication odl:hasTool ex:Tool_Nuoyun .
ex:Theme_AIApplication odl:hasIndicator ex:Indicator_AIMonitoringAccessRate .
ex:Theme_AIApplication odl:hasIndicator ex:Indicator_ScheduleRate .
ex:Theme_AIApplication odl:hasRisk ex:Risk_AIMonitoringFalsePositives .

### 6. 关键批量的量时趋势监控
ex:Theme_BatchMonitoring rdf:type odl:Theme ;
  rdfs:label "关键批量的量时趋势监控" ;
  odl:description "针对大数据加工数据量和耗时处理需要有容量管理机制和趋势监控，关键批量趋势监控能力跟联机接口一致。" ;
  odl:themeCategory "数据治理类" ;
  odl:themeFocus "数据量监控、耗时监控、容量管理、趋势监控" ;
  odl:startTime "2025-12-01T00:00:00"^^xsd:dateTime ;
  odl:plannedCompletionTime "2026-04-30T23:59:59"^^xsd:dateTime ;
  odl:status "实施中" ;
  odl:priority "普通" ;
  odl:belongsTo ex:ODL_Project ;
  odl:responsibleFor ex:Person_LiuShiFen ;
  odl:contentDescription "确定关键批量数据量监控方案及计划，各部门开始数据量上报，3月底完成日报上报" ;
  odl:progress "平台批量监控指标已上报2,788个。财富、企同、财富数字产品部、CNC已完成上报" ;
  odl:delayReason "因CNC灰度指标检测需求可能延迟两周" .

ex:Theme_BatchMonitoring odl:hasTool ex:Tool_DQM .
ex:Theme_BatchMonitoring odl:hasTool ex:Tool_WTSS .
ex:Theme_BatchMonitoring odl:hasIndicator ex:Indicator_BatchDataVolumeIndicators .

### 7. ODL会议智能体的应用
ex:Theme_MeetingAgent rdf:type odl:Theme ;
  rdfs:label "ODL会议智能体的应用" ;
  odl:description "推动ODL会议采用AI native方式开展，探索AI在会议组织、材料整理、信息收集等环节的应用。不追求端到端AI流程自动化，优先探索日常工作中AI可完成的环节。" ;
  odl:themeCategory "AI赋能类" ;
  odl:themeFocus "AI会议、材料整理、信息收集、邮件评审" ;
  odl:startTime "2026-04-01T00:00:00"^^xsd:dateTime ;
  odl:plannedCompletionTime "2099-12-31T23:59:59"^^xsd:dateTime ;
  odl:status "启动中" ;
  odl:priority "重要" ;
  odl:belongsTo ex:ODL_Project ;
  odl:contentDescription "江总要求ODL会议采用AI native方式开展。目前部分环节已实现AI应用，如会前材料整理、摘要等。前端数据收集和提供材料环节需进一步实现AI内驱。" ;
  odl:effectiveSolution "不追求端到端的AI流程，先明确工作中可由AI完成的部分和需手动完成的部分，逐步提高AI应用比例" ;
  odl:progress "邮箱Skills接入与应用、Tool CLI化进展、端到端试点推广" .

ex:Theme_MeetingAgent odl:hasTool ex:Tool_CallCode .
ex:Theme_MeetingAgent odl:hasTool ex:Tool_MBot .
ex:Theme_MeetingAgent odl:hasTool ex:Tool_ClaudeCode .

### 8. 新专题探索
ex:Theme_NewExploration rdf:type odl:Theme ;
  rdfs:label "新专题探索" ;
  odl:description "推动各部门提出运维痛点的OKR专题，探索AI智能评审、版本评审等新工作的推广。" ;
  odl:themeCategory "" ;
  odl:themeFocus "运维痛点OKR专题探索、AI智能评审、版本评审" ;
  odl:startTime "2026-03-01T00:00:00"^^xsd:dateTime ;
  odl:plannedCompletionTime "2099-12-31T23:59:59"^^xsd:dateTime ;
  odl:status "推进中" ;
  odl:priority "普通" ;
  odl:belongsTo ex:ODL_Project ;
  odl:contentDescription "各部门需拿出一两个运维痛点的ODL专题，部分部门正在进行AI智能评审、版本评审工作" .
