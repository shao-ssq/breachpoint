# 会议实例
#############################################################

### ODL月度例会系列
ex:Meeting_Monthly_20260206 rdf:type odl:Meeting ;
  rdfs:label "2026年2月ODL月度会议" ;
  odl:meetingTitle "2026年2月ODL月度会议" ;
  odl:meetingType "月度例会" ;
  odl:startTime "2026-02-06T14:00:00"^^xsd:dateTime ;
  odl:endTime "2026-02-06T15:00:00"^^xsd:dateTime ;
  odl:location "前海大厦9楼921会议室" ;
  odl:host ex:Person_HeLiu ;
  odl:recorder ex:Person_HeLiu ;
  odl:meetingContent "ODL主题月度例会待办、ODL主题建设情况、运营管理例会ODL进展" ;
  odl:meetingConclusion "ODL月度会应聚焦有价值的内容，避免无意义的形式主义，聚焦需讨论和决策的内容，如风险与阻碍、延期原因等。持续优化KBS知识库的使用过程。" ;
  odl:discussionIn ex:ODL_Project ;
  odl:hasDocument ex:Document_Minute_20260206 .

ex:Meeting_Monthly_20260320 rdf:type odl:Meeting ;
  rdfs:label "2026年3月ODL项目月会" ;
  odl:meetingTitle "2026年3月ODL项目月会" ;
  odl:meetingType "月度例会" ;
  odl:startTime "2026-03-20T14:00:00"^^xsd:dateTime ;
  odl:endTime "2026-03-20T15:00:00"^^xsd:dateTime ;
  odl:location "前海大厦9楼921会议室" ;
  odl:host ex:Person_HeLiu ;
  odl:recorder ex:Person_HeLiu ;
  odl:meetingContent "ODL主题月度例会待办、ODL主题建设情况、ODL项目管理智能体交互" ;
  odl:meetingConclusion "AI原生方法将应用于项目管理中，特别是在结果管理方面，AI将辅助跟踪任务进展和质量。会议材料需要包含问题的原因分析、解决方案和所需资源。" ;
  odl:hasTodo ex:Todo_ShareAINative ;
  odl:hasTodo ex:Todo_ImproveMeetingTemplate ;
  odl:hasTodo ex:Todo_CombiningWithZhixiao ;
  odl:hasDocument ex:Document_Minute_20260320 .

